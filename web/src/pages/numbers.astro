---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.config.js";
---
<Base title="The numbers · Wörgl" description="1,000,000 coins, who controls them, and live figures read from the contract on NEAR testnet." active="/numbers">
<section class="section lead-section" aria-labelledby="numbers-title">
  <h1 id="numbers-title" class="page-title">The numbers</h1>
  <p class="prose"><b>1,000,000 coins exist, ever.</b> Nobody can mint more, and nobody can change the rules once the contract starts.</p>

  <h2 style="margin-top:var(--s7)">Where the coins are now</h2>
  <p id="data-status" class="status" role="status"></p>
  <div class="stats">
    <div class="stat"><p class="label">In the town pot</p><p class="figure-cell treasury" id="v-treasury">–</p></div>
    <div class="stat"><p class="label">In people's hands</p><p class="figure-cell" id="v-circ">–</p></div>
    <div class="stat"><p class="label">Can still be paid out today</p><p class="figure-cell treasury" id="v-allow">–</p></div>
  </div>
  <p class="hint"><span id="v-allow-note"></span> One starting coin is worth <b class="num" id="v-index">–</b> now. The town pot is also called the treasury in the contract.</p>
</section>


<section class="section" aria-labelledby="move-title">
 <div class="two-col">
  <div>
  <h2 id="move-title">How the coins move</h2>
  <dl class="ledger plain">
    <div class="line"><dt>They start</dt><dd class="gloss">All 1,000,000 are in the town pot.</dd></div>
    <div class="line"><dt>They go out</dt><dd class="gloss">Through payouts the governor approves (in the demo, a DAO), up to 10% of the pot a day. For testing there is also a one-time faucet of 100 coins per account. It is separate: it does not use the payout limit, and it stops once the pot is down to half.</dd></div>
    <div class="line"><dt>They come back</dt><dd class="gloss">Every balance melts on a fixed schedule, and what melts returns to the pot.</dd></div>
    <div class="line"><dt>Who is in charge</dt><dd class="gloss">A governor chosen at deployment, usually a DAO with any approval rule. The demo's DAO has three members and needs two. The contract sets the limits.</dd></div>
  </dl>
  </div>
  <div>
  <h2 id="rules-title">The rules, read from the contract</h2>
  <dl class="ledger rules" id="rules"><div class="line"><dt>Loading the rules</dt><dd class="figure-cell">…</dd></div></dl>
  </div>
 </div>
</section>

<section class="section" aria-labelledby="act-title">
  <h2 id="act-title" class="sr-only">Activity</h2>
  <div class="two-col">
    <div>
      <h3 style="margin-top:0">Recent activity</h3>
      <ul class="log" id="activity"><li>Loading recent activity…</li></ul>
    </div>
    <div>
      <h3 style="margin-top:0">DAO proposals</h3>
      <ul class="log" id="proposals"><li>Loading proposals…</li></ul>
      <p><a id="dao-link" href={`${SITE.EXPLORER}/address/${SITE.DAO_ID}`}>Open the DAO on NearBlocks</a></p>
    </div>
  </div>
</section>
<section class="section" aria-labelledby="life-title">
  <details class="proof">
    <summary id="life-title">How long this demo copy runs</summary>
    <p class="prose" id="notice"></p>
    <div class="life" id="life">
      <div class="life-track" aria-hidden="true">
        <span class="life-a" id="life-a"></span><span class="life-b" id="life-b"></span><span class="life-c" id="life-c"></span>
        <i class="life-now" id="life-now"></i>
      </div>
      <ol class="life-marks">
        <li><i class="life-sw life-a"></i><b id="life-d1">–</b>Accurate for every amount until then</li>
        <li><i class="life-sw life-b"></i><b id="life-d2">–</b>100-coin claims still work until then</li>
        <li><i class="life-sw life-c"></i><b id="life-d3">–</b>Every balance reads zero from then</li>
      </ol>
    </div>
  </details>
</section>
<p class="next">Want to check how a balance is worked out? <a class="button solid" href="/maths">Next: the maths</a></p>
</Base>
