---
// Shared frame for every page: testnet banner, sticky nav, footer, and the one script that powers the live parts.
import "../styles/style.css";
interface Props { title: string; description: string; active?: string }
const { title, description, active } = Astro.props;
const nav = [
  ["/idea", "The idea"],
  ["/try", "Try it"],
  ["/numbers", "The numbers"],
  ["/maths", "The maths"],
  ["/faq", "FAQ"],
];
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23E3E8DA'/%3E%3Crect x='3' y='3' width='26' height='26' fill='none' stroke='%2316202C' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='6' fill='none' stroke='%23B0243A' stroke-width='2.5'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preload" href="/fonts/Jost-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/SourceSerif4-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href={favicon} />
</head>
<body>
  <div class="testnet-banner" role="note">
    <b>NEAR HACKATHON project, live on testnet.</b>{" "}The coins have no value.
  </div>
  <header class="topbar" id="top">
    <div class="topbar-inner">
      <a class="wordmark" href="/" aria-label="Wörgl, home">Wörgl</a>
      <span class="badge">testnet</span>
      <nav aria-label="Pages">
        <ul id="nav">
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={active === href ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="right">
        <span id="account" aria-live="polite">No wallet connected</span>
        <button id="connect" type="button" class="solid">Connect wallet</button>
      </div>
    </div>
  </header>

  <div class="page">
    <main>
      <slot />
    </main>

    <footer>
      <dl>
        <dt>Repository</dt><dd><a id="f-repo" href="https://github.com/devendra116/worgl">github.com/devendra116/worgl</a></dd>
        <dt>Token contract</dt><dd><a id="f-token" href="#"></a></dd>
        <dt>DAO</dt><dd><a id="f-dao" href="#"></a></dd>
        <dt>History</dt><dd><a href="https://en.wikipedia.org/wiki/W%C3%B6rgl">Wörgl</a> and <a href="https://en.wikipedia.org/wiki/Demurrage_(currency)">Demurrage (currency)</a> on Wikipedia; <a href="https://de.wikipedia.org/wiki/W%C3%B6rgler_Schwundgeld">Wörgler Schwundgeld</a> (German Wikipedia).</dd>
      </dl>
      <p><b>A hackathon project on NEAR testnet.</b> Built at NEAR HACKATHON. The coins have no value, and nothing here has been audited. Most of the code in this project was written by an AI assistant (Claude Code) under the project owner's direction.</p>
      <p class="faded">Fonts: Jost and Source Serif 4, both under the SIL Open Font License.</p>
    </footer>
  </div>

  <script>
    import "../scripts/app.js";
  </script>
</body>
</html>
